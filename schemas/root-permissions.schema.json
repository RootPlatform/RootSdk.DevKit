{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Permissions",
  "description": "Permissions control which parts of the Root Community API your code is able to use.",
  "x-doc-details": "Declare your permissions in the `permissions` section of your manifest. All permissions default to `false`; set the ones you need to `true`.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "community": {
      "type": "object",
      "description": "Permissions scoped to the community level.",
      "additionalProperties": false,
      "properties": {
        "manageCommunity": {
          "type": "boolean",
          "description": "Manage overall community settings.",
          "default": false
        },
        "manageRoles": {
          "type": "boolean",
          "description": "Create or update community roles.",
          "default": false
        },
        "manageEmojis": {
          "type": "boolean",
          "description": "Upload or remove custom emojis.",
          "default": false
        },
        "createInvite": {
          "type": "boolean",
          "description": "Generate new community invites.",
          "default": false
        },
        "manageInvites": {
          "type": "boolean",
          "description": "Revoke or list existing invites.",
          "default": false
        },
        "createBan": {
          "type": "boolean",
          "description": "Ban members from the community.",
          "default": false
        },
        "manageBans": {
          "type": "boolean",
          "description": "Unban or list banned members.",
          "default": false
        },
        "kick": {
          "type": "boolean",
          "description": "Remove members from the community.",
          "default": false
        },
        "changeOtherNickname": {
          "type": "boolean",
          "description": "Change nicknames of other members.",
          "default": false
        },
        "createChannelGroup": {
          "type": "boolean",
          "description": "Create new channel groups.",
          "default": false
        }
      }
    },
    "channel": {
      "type": "object",
      "description": "Permissions scoped to individual channels.",
      "additionalProperties": false,
      "properties": {
        "fullControl": {
          "type": "boolean",
          "description": "All channel permissions.",
          "default": false
        },
        "useExternalEmoji": {
          "type": "boolean",
          "description": "Use emojis from other servers.",
          "default": false
        },
        "createMessage": {
          "type": "boolean",
          "description": "Send new messages.",
          "default": false
        },
        "deleteMessageOther": {
          "type": "boolean",
          "description": "Delete messages sent by others.",
          "default": false
        },
        "managePinnedMessages": {
          "type": "boolean",
          "description": "Pin or unpin messages.",
          "default": false
        },
        "viewMessageHistory": {
          "type": "boolean",
          "description": "Read past messages.",
          "default": false
        },
        "createMessageAttachment": {
          "type": "boolean",
          "description": "Attach files to messages.",
          "default": false
        },
        "createMessageMention": {
          "type": "boolean",
          "description": "Mention users in messages.",
          "default": false
        },
        "createMessageReaction": {
          "type": "boolean",
          "description": "React to messages.",
          "default": false
        },
        "moveUserOther": {
          "type": "boolean",
          "description": "Move other users between voice channels.",
          "default": false
        },
        "voiceMuteOther": {
          "type": "boolean",
          "description": "Mute other users in voice channels.",
          "default": false
        },
        "voiceDeafenOther": {
          "type": "boolean",
          "description": "Deafen other users in voice channels.",
          "default": false
        },
        "voiceKick": {
          "type": "boolean",
          "description": "Kick users from voice channels.",
          "default": false
        },
        "manageFiles": {
          "type": "boolean",
          "description": "Upload or download files in channels.",
          "default": false
        },
        "createFile": {
          "type": "boolean",
          "description": "Create new files in channels.",
          "default": false
        },
        "viewFile": {
          "type": "boolean",
          "description": "View files shared in channels.",
          "default": false
        }
      }
    }
  },
  "examples": [
    {
      "permissions": {
        "community": {
          "kick": true
        },
        "channel": {
          "createMessage": true,
          "deleteMessageOther": true
        }
      }
    }
  ]
}
