{
  "id": "xxxxxxxxxxxxxxxxxxxxxx",
  "version": "1.0.0",
  "package": {
    "server": {
      "launch": "dist/main.js",
      "deploy": [
          "dist"
      ],
      "nodeModules": [
          "node_modules"
      ]
    }
  },
  "settings": {
    "groups": [
      {
        "key": "general",
        "title": "General",
        "items": [
          {
            "key": "assignedRole",
            "title": "Assigned Role",
            "description": "Role granted to a member after they post the message threshold",
            "required": true,
            "roleOrMember": {
              "selectBehavior": "roleSingle"
            }
          }
        ]
      }
    ]
  },
  "permissions": {
    "community": {
      "manageRoles": true
    }
  }
}
