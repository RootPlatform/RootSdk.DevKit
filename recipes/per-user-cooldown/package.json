{
  "name": "@rootsdk-recipe/per-user-cooldown",
  "author": "Root Communications, Inc.",
  "description": "Recipe: rate-limit a per-user action atomically — INSERT … ON CONFLICT DO UPDATE WHERE so two concurrent calls from the same user can't both succeed.",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@rootsdk/server-app": "0.17.1-alpha.6",
    "@peruser-cooldown/gen-server": "file:./networking/gen/server",
    "@peruser-cooldown/gen-shared": "file:./networking/gen/shared"
  },
  "devDependencies": {
    "@rootsdk/dev-tools": "0.17.1-alpha.6",
    "@rootsdk/client-app": "0.17.1-alpha.6",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "node clean.js"
  },
  "workspaces": {
    "packages": [
      "./networking",
      "./server"
    ]
  }
}
