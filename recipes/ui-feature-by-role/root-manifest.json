{
  "id": "xxxxxxxxxxxxxxxxxxxxxx",
  "version": "1.0.0",
  "package": {
    "client": {
      "deploy": "client/dist"
    },
    "server": {
      "launch": "server/dist/main.js",
      "deploy": [
        "server/dist",
        "networking/gen/server"
      ],
      "nodeModules": [
        "node_modules"
      ]
    }
  },
  "settings": {
    "groups": [
      {
        "key": "general",
        "title": "General",
        "items": [
          {
            "key": "moderatorRole",
            "title": "Moderator Role",
            "description": "Users in the selected role(s) see the moderator panel. The community owner is always elevated regardless of this setting.",
            "required": false,
            "confirmation": "Save",
            "roleOrMember": {
              "selectBehavior": "roleMultiAndUserMulti"
            }
          }
        ]
      }
    ]
  },
  "permissions": {
    "channel": {
      "createMessage": true
    }
  }
}
