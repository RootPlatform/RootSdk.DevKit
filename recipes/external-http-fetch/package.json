{
  "name": "@rootsdk-recipe/external-http-fetch",
  "author": "Root Communications, Inc.",
  "description": "Recipe: call an external HTTP API from your server with a timeout, type the failure modes, and surface the result to the client.",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@rootsdk/server-app": "0.17.1-alpha.6",
    "@rootsdk/client-app": "0.17.1-alpha.6",
    "@externalhttpfetch/gen-client": "file:./networking/gen/client",
    "@externalhttpfetch/gen-server": "file:./networking/gen/server",
    "@externalhttpfetch/gen-shared": "file:./networking/gen/shared"
  },
  "devDependencies": {
    "@rootsdk/dev-tools": "0.17.1-alpha.6",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "node clean.js"
  },
  "workspaces": {
    "packages": [
      "./networking",
      "./server",
      "./client"
    ]
  }
}
