{
  "name": "@{project}/app",
  "description": "{project}",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@rootsdk/client-app": "^0.19.1",
    "@rootsdk/server-app": "^0.19.1",
    "@{project}/gen-client": "file:./networking/gen/client",
    "@{project}/gen-server": "file:./networking/gen/server",
    "@{project}/gen-shared": "file:./networking/gen/shared"
  },
  "devDependencies": {
    "@rootsdk/dev-tools": "^0.19.1",
    "typescript": "^5.8.2",
    "@types/node": "^22.10.2"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "node clean.js"
  },
  "workspaces": {
    "packages": [
      "./networking",
      "./server",
      "./client"
    ]
  }
}
