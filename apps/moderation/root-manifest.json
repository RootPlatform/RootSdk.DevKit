{
  "id": "AC59nCbZgwmrnzsYa7vAXA",
  "version": "1.0.3",
  "package": {
    "client": {
      "deploy": "client/dist"
    },
    "server": {
      "launch": "server/dist/main.js",
      "deploy": [
        "server/dist",
        "networking/gen/server"
      ],
      "nodeModules": [
        "node_modules"
      ]
    }
  },
  "settings": {
    "groups": [
      {
        "key": "general",
        "title": "General",
        "items": [
          {
            "key": "admins",
            "title": "Moderation admins",
            "description": "Roles and members who can configure moderation, view the audit log, and take manual actions. The community owner is always elevated regardless of this setting.",
            "required": true,
            "confirmation": "Save",
            "roleOrMember": {
              "selectBehavior": "roleMultiAndUserMulti"
            }
          }
        ]
      }
    ]
  },
  "permissions": {
    "community": {
      "fullControl": true
    }
  }
}
